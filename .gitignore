# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# CodeLineage output (generated by `build`, `explore`, `chat` logging)
.lineage/
lineage.html
*.jsonl

# Secrets and local settings: never commit
.env
.env.*
*.pem
*.key
*service-account*.json
*credentials*.json
application_default_credentials.json

# Company data must never land in this repo (it is pulled to the
# company laptop, never pushed from it). Put real SQL repos and
# INFORMATION_SCHEMA exports outside this folder.
/company/
/local/
*.local.yaml
*.local.yml

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
.vscode/*
!.vscode/tasks.json
